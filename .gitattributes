# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Godot scene and resource files
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.import text eol=lf

# Documentation, scripts, and configs
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.desktop text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.blend binary
*.blend1 binary
*.ogg binary
*.wav binary
*.mp3 binary
